// merge two sorted arrays
#include <iostream>
using namespace std;
vector<int> mergeSortedArrays(vector<int> &a, vector<int> &b)
{
    int i = 0, j = 0;
    int m = a.size();
    int n = b.size();
    vector<int> c;
    while (i < m && j < n)
    {
        if (a[i] < b[j])
        {
            c.push_back(a[i]);
            i++;
        }
        else
        {
            c.push_back(b[j]);
            j++;
        }
    }
    while (i < m)
    {
        c.push_back(a[i]);
        i++;
    }
    while (j < n)
    {
        c.push_back(b[j]);
        j++;
    }
    return c;
}
