// selection sort
#include <iostream>
using namespace std;
int main()
{
    int arr[] = {3, 2, 5, 4, 1};

    for (int i = 0; i < 4; i++)
    {
        for (int j = i; j < 5; j++)
        {
            if (arr[i] > arr[j])
            {
                swap(arr[i], arr[j]);
            }
        }
    }

    for (int i = 0; i < 5; i++)
    {
        cout << arr[i] << " ";
    }
}
// second method
// bubble sort
#include <iostream>
using namespace std;
void bubble_sort(int arr[], int n)
{
    for (int i = 1; i < n; i++)
    {
        for (int j = 0; j < n - i; j++)
        {
            if (arr[j] > arr[j + 1])
            {
                swap(arr[j], arr[j + 1]);
            }
        }
    }

    for (int i = 0; i < n; i++)
    {
        cout << arr[i] << " ";
    }
}

int main()
{
    int arr[] = {2, 3, 6, 4, 5, 1};
    int n = sizeof(arr) / sizeof(int);
    bubble_sort(arr, n);

    return 0;
}
